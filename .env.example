# -----------------------------------------------------------------------------
# Dev AI Sentinel — Environment Configuration Template
# Copy this file to .env before starting development:
#   cp .env.example .env
# -----------------------------------------------------------------------------

# API Server Configuration
PORT=4000
NODE_ENV=development

# Database Connection (SQLite default for local development, or PostgreSQL URL)
DATABASE_URL="file:./dev.db"

# Web Client Configuration
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Optional GitHub token for higher rate limits (Placeholder only)
GITHUB_ACCESS_TOKEN="your_github_personal_access_token_here"
