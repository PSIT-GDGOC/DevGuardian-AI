{
  "name": "dev-ai-sentinel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dev AI Sentinel — Automated project guardian and code analysis platform for GDG on Campus",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace=@dev-ai-sentinel/api run dev",
    "dev:api": "npm --workspace=@dev-ai-sentinel/api run dev",
    "dev:web": "npm --workspace=@dev-ai-sentinel/web run dev",
    "build": "npm run build:contracts && npm run build:analysis-engine && npm run build:api",
    "build:contracts": "npm --workspace=@dev-ai-sentinel/contracts run build",
    "build:analysis-engine": "npm --workspace=@dev-ai-sentinel/analysis-engine run build",
    "build:api": "npm --workspace=@dev-ai-sentinel/api run build",
    "build:web": "npm --workspace=@dev-ai-sentinel/web run build",
    "test": "vitest run",
    "test:contracts": "npm --workspace=@dev-ai-sentinel/contracts run test",
    "test:analysis-engine": "npm --workspace=@dev-ai-sentinel/analysis-engine run test",
    "test:api": "npm --workspace=@dev-ai-sentinel/api run test",
    "test:web": "npm --workspace=@dev-ai-sentinel/web run test",
    "typecheck": "npm --workspace=@dev-ai-sentinel/contracts run typecheck && npm --workspace=@dev-ai-sentinel/analysis-engine run typecheck && npm --workspace=@dev-ai-sentinel/api run typecheck && npm --workspace=@dev-ai-sentinel/web run typecheck",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "prisma": "^5.18.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
