{
  "name": "dev-ai-sentinel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dev AI Sentinel — Automated project guardian and code analysis platform for GDG on Campus",
  "workspaces": [
    "frontend",
    "backend",
    "ai-ml"
  ],
  "scripts": {
    "dev": "npm --workspace=@dev-ai-sentinel/backend run dev",
    "dev:backend": "npm --workspace=@dev-ai-sentinel/backend run dev",
    "dev:frontend": "npm --workspace=@dev-ai-sentinel/web run dev",
    "build": "npm run build:ai-ml && npm run build:backend",
    "build:ai-ml": "npm --workspace=@dev-ai-sentinel/ai-ml run build",
    "build:backend": "npm --workspace=@dev-ai-sentinel/backend run build",
    "build:frontend": "npm --workspace=@dev-ai-sentinel/web run build",
    "test": "vitest run",
    "test:backend": "npm --workspace=@dev-ai-sentinel/backend run test",
    "test:frontend": "npm --workspace=@dev-ai-sentinel/web run test",
    "test:ai-ml": "npm --workspace=@dev-ai-sentinel/ai-ml run test",
    "typecheck": "npm --workspace=@dev-ai-sentinel/ai-ml run typecheck && npm --workspace=@dev-ai-sentinel/backend run typecheck && npm --workspace=@dev-ai-sentinel/web run typecheck",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "prisma": "^5.18.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
